<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>RobloxMultiClient.Tests</RootNamespace>
    <AssemblyName>RobloxMultiClient.Tests</AssemblyName>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <!-- Run through `dotnet exec` instead of a generated apphost, so a deep checkout path does not
         exceed Windows' 260-character limit when the runner starts the test assembly. -->
    <UseAppHost>false</UseAppHost>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\RobloxMultiClient.Core\RobloxMultiClient.Core.csproj" />
    <ProjectReference Include="..\..\src\RobloxMultiClient.Windows\RobloxMultiClient.Windows.csproj" />
    <ProjectReference Include="..\..\src\RobloxMultiClient.App\RobloxMultiClient.App.csproj" />
    <!-- Build order only: the fake client is copied by RenameFakeClient below. -->
    <ProjectReference Include="..\FakeRobloxClient\FakeRobloxClient.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <!-- Stage the harmless fake client beside the tests so scenarios never need the real one. -->
  <Target Name="PrepareFakeClient" AfterTargets="Build">
    <ItemGroup>
      <FakeArtifacts Include="$(MSBuildThisFileDirectory)..\..\artifacts\fake\**\*" />
    </ItemGroup>
    <MakeDir Directories="$(OutDir)fake" />
    <Copy SourceFiles="@(FakeArtifacts)" DestinationFolder="$(OutDir)fake" SkipUnchangedFiles="true" />
  </Target>
</Project>
