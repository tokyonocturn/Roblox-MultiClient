<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    <!--
      Without SourceLink the compiler embeds the absolute checkout path into the assembly, so two
      clones of the same commit produced different binaries. Mapping the repository root to /_/
      makes the output independent of where the tree lives, which is what lets a release hash be
      reproduced by anyone.
    -->
    <PathMap>$(MSBuildThisFileDirectory)=/_/</PathMap>
    <!--
      Keep the source revision out of AssemblyInformationalVersion: a commit that only touches
      documentation must not change the executable, otherwise the published hash can never match
      the tree it ships with.
    -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Version>1.0.0</Version>
    <Company>Camo</Company>
    <Product>Roblox MultiClient</Product>
    <Copyright>Copyright (c) 2026 Camo</Copyright>
    <NeutralLanguage>en</NeutralLanguage>
    <EnableDefaultNoneItems>false</EnableDefaultNoneItems>
  </PropertyGroup>
</Project>
